"Max temperature" = "tmax"),
selected = "pr"),
sliderInput("idx", "Month:", min = 1, max = length(tm_pr),
value = length(tm_pr), step = 1, width = "100%",
animate = animationOptions(interval = 1200, loop = TRUE)),
strong(textOutput("month_label", inline = TRUE)),
hr(),
h4(textOutput("site_name")),
radioButtons("run", "Model run:",
choices = c("Day of year only" = "doy_only",
"Environment only" = "env_only",
"Env + DOY" = "env_plus_doy"),
selected = "env_plus_doy"),
uiOutput("skill_stats"),
tabsetPanel(
tabPanel("By year", plotOutput("prob_plot",  height = 230)),
tabPanel("Skill",   plotOutput("skill_plot", height = 230))
)
),
div(class = "map-wrap",
leafletOutput("map", height = "100vh"))
)
# ============ SERVER ============
session$onFlushed(function() {
leafletProxy("map") %>% fitBounds(-125.1, 48.5, -123.2, 49.7)
}, once = TRUE)
library(shiny)
library(leaflet)
library(terra)
# ============ LOADED ONCE, OUTSIDE THE APP ============
# river_coords  — your site data frame (stream_name_pse, model, longitude, latitude)
# preds         — read.csv("monthly_predictions_dashboard.csv")
# pr, tmax      — rast(..., subds = "pr") / rast(..., subds = "t_max")
preds$site_key <- toupper(trimws(preds$site))
tm_pr <- time(pr)
pr_s   <- disagg(pr,   fact = 8, method = "bilinear")
tmax_s <- disagg(tmax, fact = 8, method = "bilinear")
pal    <- colorFactor("Dark2", domain = river_coords$model)
pal_p  <- colorBin("YlGnBu", domain = values(pr),
bins = c(0, 25, 50, 100, 150, 200, 300, 400, 600, Inf),
na.color = "transparent")
pal_t  <- colorBin("viridis", domain = values(tmax), bins = 8,
na.color = "transparent")
PANEL_W <- 380
# ============ UI ============
ui <- fluidPage(
tags$head(tags$style(HTML(sprintf("
html, body { height: 100%%; margin: 0; }
.map-wrap { margin-left: %dpx; }
.side-panel {
background: #ffffff;
padding: 14px 16px;
box-shadow: 2px 0 8px rgba(0,0,0,0.15);
overflow-y: auto;
z-index: 1000;
}
", PANEL_W + 20)))),
absolutePanel(
fixed = TRUE,
top = 0, left = 0, bottom = 0, width = PANEL_W,
draggable = FALSE,
class = "side-panel",
h4("Site Map"),
checkboxGroupInput("model", "Model:",
choices = sort(unique(river_coords$model)),
selected = unique(river_coords$model)),
radioButtons("layer", "Climate layer:",
choices = c("None" = "none",
"Mean precipitation" = "pr",
"Max temperature" = "tmax"),
selected = "pr"),
sliderInput("idx", "Month:", min = 1, max = length(tm_pr),
value = length(tm_pr), step = 1, width = "100%",
animate = animationOptions(interval = 1200, loop = TRUE)),
strong(textOutput("month_label", inline = TRUE)),
hr(),
h4(textOutput("site_name")),
radioButtons("run", "Model run:",
choices = c("Day of year only" = "doy_only",
"Environment only" = "env_only",
"Env + DOY" = "env_plus_doy"),
selected = "env_plus_doy"),
uiOutput("skill_stats"),
tabsetPanel(
tabPanel("By year", plotOutput("prob_plot",  height = 230)),
tabPanel("Skill",   plotOutput("skill_plot", height = 230))
)
),
div(class = "map-wrap",
leafletOutput("map", height = "100vh"))
)
# ============ SERVER ============
server <- function(input, output, session) {
filtered <- reactive({
river_coords[river_coords$model %in% input$model, ]
})
selected_site <- reactiveVal(NULL)
observeEvent(input$map_marker_click, {
selected_site(input$map_marker_click$id)
})
site_preds <- reactive({
req(selected_site())
d <- preds[preds$site_key == selected_site() & preds$run == input$run, ]
req(nrow(d) > 0)
d
})
output$month_label <- renderText(format(tm_pr[input$idx], "%B %Y"))
# ---- base map ----
output$map <- renderLeaflet({
leaflet() %>%
addProviderTiles(providers$CartoDB.Positron, group = "Street") %>%
addProviderTiles(providers$Esri.WorldImagery, group = "Satellite") %>%
fitBounds(min(river_coords$longitude), min(river_coords$latitude),
max(river_coords$longitude), max(river_coords$latitude)) %>%
addLayersControl(baseGroups = c("Street", "Satellite"),
options = layersControlOptions(collapsed = TRUE))
})
# ---- climate raster ----
observe({
leafletProxy("map") %>% clearGroup("Climate")
req(input$layer != "none")
idx <- input$idx
req(!is.null(idx))
if (input$layer == "pr") {
r <- pr_s[[idx]];   p <- pal_p; sv <- values(pr);   unit <- "mm/month"
} else {
r <- tmax_s[[idx]]; p <- pal_t; sv <- values(tmax); unit <- "\u00B0C"
}
leafletProxy("map") %>%
addRasterImage(r, colors = p, opacity = 0.85,
group = "Climate", project = FALSE, method = "bilinear") %>%
addLegend("bottomright", pal = p, values = sv,
layerId = "climate_legend",
title = paste0(format(tm_pr[idx], "%B %Y"), "<br>(", unit, ")"))
})
# ---- site markers (redrawn after raster so they stay on top) ----
observe({
input$idx; input$layer
req(nrow(filtered()) > 0)
leafletProxy("map", data = filtered()) %>%
clearGroup("Sites") %>%
addCircleMarkers(~longitude, ~latitude,
group = "Sites",
layerId = ~stream_name_pse,
fillColor = ~pal(model),
fillOpacity = 0.9, stroke = FALSE, radius = 6,
label = ~stream_name_pse,
popup = ~paste0("<b>", stream_name_pse,
"</b><br>Model: ", model))
})
# ---- highlight ring on the clicked site ----
observeEvent(input$map_marker_click, {
click <- input$map_marker_click
leafletProxy("map") %>%
clearGroup("selected") %>%
addCircleMarkers(lng = click$lng, lat = click$lat, group = "selected",
radius = 11, color = "black", weight = 3,
fillOpacity = 0)
})
# ---- prediction panel ----
output$site_name <- renderText({
if (is.null(selected_site())) "Click a site" else selected_site()
})
output$skill_stats <- renderUI({
if (is.null(selected_site()))
return(HTML("<p style='color:#888'><i>No site selected.</i></p>"))
d <- preds[preds$site_key == selected_site() & preds$run == input$run, ]
if (nrow(d) == 0)
return(HTML("<p style='color:#888'><i>No predictions for this site.</i></p>"))
hit <- d[d$actual_arrival_month == 1, ]
HTML(paste0("<b>Years:</b> ", length(unique(d$year)), "<br>",
"<b>Mean prob. on true month:</b> ",
round(mean(hit$mean_predicted_probability, na.rm = TRUE), 3)))
})
output$prob_plot <- renderPlot({
d <- site_preds()
cols <- c(Aug = "#fdae61", Sep = "#2b8cbe", Oct = "#7570b3")
par(mar = c(4, 4, 1, 1))
plot(range(d$year),
c(0, max(d$mean_predicted_probability, na.rm = TRUE) * 1.15),
type = "n", xlab = "Year", ylab = "Predicted probability")
for (m in names(cols)) {
dm <- d[d$month_name == m, ]
if (nrow(dm)) lines(dm$year, dm$mean_predicted_probability,
col = cols[m], lwd = 2)
}
act <- d[d$actual_arrival_month == 1, ]
points(act$year, act$mean_predicted_probability, pch = 21,
bg = cols[as.character(act$month_name)], col = "black", cex = 1.3)
legend("topleft", c(names(cols), "Actual"),
col = c(cols, "black"), lwd = c(2, 2, 2, NA),
pch = c(NA, NA, NA, 21), bty = "n", cex = 0.8, horiz = TRUE)
})
output$skill_plot <- renderPlot({
req(selected_site())
d <- preds[preds$site_key == selected_site() &
preds$actual_arrival_month == 1, ]
req(nrow(d) > 0)
s <- tapply(d$mean_predicted_probability, d$run, mean, na.rm = TRUE)
par(mar = c(7, 4, 1, 1))
barplot(s, col = c("#2b8cbe", "#d95f02", "#7570b3"), border = NA,
ylab = "Mean prob. on true month", las = 2, cex.names = 0.85)
})
session$onFlushed(function() {
leafletProxy("map") %>% fitBounds(-125.1, 48.5, -123.2, 49.7)
}, once = TRUE)
}
shinyApp(ui, server)
library(shiny)
library(rmapshaper)
library(DT)
library(sf)
library(htmltools)
library(leafsync)
library(kableExtra)
library(tidyverse)
library(leaflet)
library(ggthemes)
library(ggridges)
library(ggmap)
library(lubridate)
library(stringr)
library(readr)
library(broom)
library(RColorBrewer)
library(forcats)
library(colorspace)
library(visdat)
library(naniar)
library(ggrepel)
library(styler)
library(lintr)
library(tidycensus)
library(gt)
library(sf)
library(viridis)
library(terra)
library(ncdf4)
river_coords <- read_csv("~/FishyG/data/survey_sites_vancouver_isl.csv", show_col_types = FALSE)
tasmax <- rast("~/FishyG/data/Global_weather/PNWNamet_tasmax.nc.nc")
tmax <- rast("~/FishyG/data/Global_weather/t_max_monthly_1960_2025.nc", subds = "t_max")
pr <- rast("~/FishyG/data/Global_weather/monthly_prcp_1960_2025.nc", subds = "pr")
river_coords <- river_coords %>%
mutate(model = case_when(
stream_name_pse %in% c("NANAIMO RIVER", "COWICHAN RIVER", "LITTLE QUALICUM RIVER", "CHEMAINUS RIVER") ~ "Model", TRUE ~"No model"
))
pal <- colorFactor("Dark2", domain = river_coords$model)
preds <- read.csv("~/FishyG/model_output/monthly_predictions_dashboard.csv", stringsAsFactors = FALSE)
preds$month_name <- factor(preds$month_name, levels = c("Aug", "Sep", "Oct"))
preds$site_key <- toupper(trimws(preds$site))
tm_pr <- time(pr)
pr_years  <- as.integer(format(tm_pr, "%Y"))
pr_months <- as.integer(format(tm_pr, "%m"))
pal_p <- colorQuantile("Blues", values(pr), n = 7, na.color = "transparent")
pal_t <- colorBin("RdYlBu", domain = values(tmax), bins = 8,
na.color = "transparent", reverse = TRUE)
ui <- fluidPage(
leafletOutput("map", height = 600),
absolutePanel(
bottom = 120, left = 30, width = 250,
draggable = TRUE,
style = "background: rgba(255,255,255,0.9); padding: 12px;
border-radius: 5px; box-shadow: 0 0 8px rgba(0,0,0,0.2);",
titlePanel("Site Map"),
checkboxGroupInput("model", "Model:",
choices = sort(unique(river_coords$model)),
selected = unique(river_coords$model)),
hr(),
radioButtons("layer", "Climate layer:",
choices = c("None" = "none",
"Mean precipitation" = "pr",
"Max temperature" = "tmax"),
selected = "pr"),
sliderInput("idx", "Month:", min = 1, max = length(tm_pr),
value = length(tm_pr), step = 1,
animate = animationOptions(interval = 1200, loop = TRUE))
)
)
pr_s   <- disagg(pr, fact = 8, method = "bilinear")
tmax_s <- disagg(tmax, fact = 8, method = "bilinear")
server <- function(input, output, session) {
filtered <- reactive({
river_coords[river_coords$model %in% input$model, ]
})
output$map <- renderLeaflet({
leaflet() %>%
addProviderTiles(providers$OpenStreetMap, group = "Street") %>%
addProviderTiles(providers$Esri.WorldImagery, group = "Satellite") %>%
fitBounds(min(river_coords$longitude), min(river_coords$latitude), max(river_coords$longitude), max(river_coords$latitude)) %>%
addLayersControl(baseGroups = c("Street", "Satellite"),
options = layersControlOptions(collapsed = TRUE))
})
observe({
leafletProxy("map") %>%
clearGroup("Climate") %>%
clearControls()
req(input$layer != "none")
idx <- input$idx
req(!is.null(idx))
if (input$layer == "pr") {
r <- pr[[idx]]; p <- pal_p; stack_vals <- values(pr); unit <- "mm/month"
} else {
r <- tmax[[idx]]; p <- pal_t; stack_vals <- values(tmax); unit <- "°C"
}
lyr <- disagg(r, fact = 8, method = "bilinear")
leafletProxy("map") %>%
addRasterImage(lyr, colors = p, opacity = 0.85,
group = "Climate", project = FALSE, method = "bilinear") %>%
addLegend("bottomright", pal = p, values = stack_vals,
title = paste0(format(tm_pr[idx], "%B %Y"), "<br>(", unit, ")"))
})
observe({
leafletProxy("map", data = filtered()) %>%
clearGroup("stream_name_pse") %>%
addCircleMarkers(~longitude, ~latitude,
group = "stream_name_pse",
fillColor = ~pal(model),
fillOpacity = 0.9,
stroke = FALSE,
radius = 6,
layerId = ~stream_name_pse,
popup = ~paste0("<b>", stream_name_pse, "</b><br>Model: ", model))
})
}
shinyApp(ui, server)
